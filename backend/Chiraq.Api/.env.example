# Export these variables in the shell before running `dotnet run`.
JWT_SECRET=replace-this-local-jwt-secret-with-32-or-more-characters
QR_HMAC_SECRET=replace-this-local-qr-secret-with-32-or-more-characters
ADMIN_TOKEN=replace-this-demo-admin-token-with-at-least-24-characters
DEMO_MODE=true
ASPNETCORE_URLS=http://localhost:5099
CORS_ORIGINS__0=http://localhost:5173
# Optional; defaults to backend/Chiraq.Api/chiraq.db
ConnectionStrings__Chiraq="Data Source=chiraq.db;Foreign Keys=True"
