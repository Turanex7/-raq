VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
VITE_DEMO_MODE=false
# Set to true in Netlify to run the browser-only demo without an API server.
VITE_PROXY_TARGET=http://localhost:5099
# Optional: a trusted development certificate whose SAN includes the phone's LAN address.
# VITE_HTTPS_CERT=/absolute/path/to/certificate.pem
# VITE_HTTPS_KEY=/absolute/path/to/private-key.pem
